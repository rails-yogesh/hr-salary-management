# Copy to `.env` at the repo root to override docker-compose defaults.
# Everything here has a working fallback baked into docker-compose.yml, so
# `docker-compose up --build` runs with zero setup — this file only matters
# if you want different credentials.

# Generate with: openssl rand -hex 64
# The insecure default in docker-compose.yml is fine for a local demo but
# should never be used anywhere reachable outside your machine.
SECRET_KEY_BASE=

# Seeded HR-admin login (see backend/db/seeds.rb).
SEED_ADMIN_EMAIL=hr@acme.test
SEED_ADMIN_PASSWORD=changeme123!
